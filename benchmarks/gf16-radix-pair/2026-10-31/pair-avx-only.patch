+            Some(
+                crate::galois_8::BackendId::RustGfniAvx2
+                    | crate::galois_8::BackendId::RustGfniAvx512
+            )
+        )
+    {
+        return false;
+    }
+    let t = NibbleTables16::build(log_m, &tables.log_lut, &tables.exp_lut);
+    // SAFETY: AVX2 is detected; mutable lanes are disjoint and pairwise equal-sized.
+    unsafe {
+        x86::butterfly_avx2::<INVERSE>(a, c, &t);
+        x86::butterfly_avx2::<INVERSE>(b, d, &t);
+    }
+    true
