+    b: &mut [u16],
+    d: &mut [u16],
+    log_m: u16,
+    tables: &LeopardGf16Tables,
+) -> bool {
+    if a.len() != c.len()
+        || b.len() != d.len()
+        || a.len() < 32
+        || b.len() < 32
+        || !is_x86_feature_detected!("avx2")
+    {
