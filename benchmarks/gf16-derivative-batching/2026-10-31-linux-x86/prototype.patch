+#[cfg(all(test, feature = "std", target_arch = "x86_64"))]
+mod derivative_batch_prototype_tests {
+    use super::{FlatWork16, compute_formal_derivative16};
+    #[test]
+    fn excessive_requested_lane_count_uses_checked_fallback() {
+        let lanes = 4usize;
+        let size = 64usize;
+        let mut work = FlatWork16::new(lanes, size);
+        let mut expected: Vec<Vec<u16>> = (0..lanes)
+            .map(|i| (0..size).map(|j| (i * 193 + j * 31) as u16).collect())
+            .collect();
+        for (i, lane) in expected.iter().enumerate() {
+            work.lane_mut(i).copy_from_slice(lane);
+        }
+        for i in 1usize..8 {
+            let width = ((i ^ (i - 1)) + 1) >> 1;
+            for j in 0..width {
+                let lo = i - width + j;
+                let hi = i + j;
+                if hi < lanes && lo < lanes {
+                    let (lower, upper) = expected.split_at_mut(hi);
+                    for (x, y) in lower[lo].iter_mut().zip(&upper[0]) {
+                        *x ^= *y;
+                    }
+                }
+            }
+        }
+        compute_formal_derivative16(&mut work, 8, size);
+        for (i, lane) in expected.iter().enumerate() {
+            assert_eq!(work.lane(i), lane);
+        }
+    }
+
+    #[test]
+    fn batched_derivative_matches_original_schedule() {
+        if !std::is_x86_feature_detected!("avx2") {
+            std::println!("AVX2 unavailable");
+            return;
+        }
+        std::println!("AVX2=true: batched derivative executed");
+        for n in [1, 2, 3, 4, 8, 16, 32, 33, 64] {
+            for size in [0, 1, 15, 16, 17, 31, 32, 33, 65, 1024] {
+                let mut work = FlatWork16::new(n, size + 3);
+                let mut reference: Vec<Vec<u16>> = (0..n)
+                    .map(|i| {
+                        (0..size + 3)
+                            .map(|j| ((i * 7919 + j * 3571 + 123) & 65535) as u16)
+                            .collect()
+                    })
+                    .collect();
+                for (i, v) in reference.iter().enumerate() {
+                    work.lane_mut(i).copy_from_slice(v);
+                }
+                for i in 1..n {
+                    let width = ((i ^ (i - 1)) + 1) >> 1;
+                    for j in 0..width {
+                        let lo = i - width + j;
+                        let hi = i + j;
+                        if hi < n && lo < n {
+                            let (before, after) = reference.split_at_mut(hi);
+                            for (a, b) in before[lo][..size].iter_mut().zip(&after[0][..size]) {
+                                *a ^= *b;
+                            }
+                        }
+                    }
+                }
+                compute_formal_derivative16(&mut work, n, size);
+                for (i, expected) in reference.iter().enumerate() {
+                    assert_eq!(work.lane(i), expected, "n={n} size={size} lane={i}");
+                }
+            }
+        }
+    }
