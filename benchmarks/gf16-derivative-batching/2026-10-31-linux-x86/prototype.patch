+#[cfg(all(feature = "std", target_arch = "x86_64"))]
+#[target_feature(enable = "avx2")]
+unsafe fn derivative_xor_avx2<const N: usize>(dst: &mut [u16], sources: [&[u16]; N]) {
+    use core::arch::x86_64::{_mm256_loadu_si256, _mm256_storeu_si256, _mm256_xor_si256};
+    let chunks = dst.len() / 16;
+    // SAFETY: caller checked AVX2, all disjoint lane views have the same length,
+    // and each vector load/store remains within one complete 16-element chunk.
+    unsafe {
+        for chunk in 0..chunks {
+            let offset = chunk * 16;
+            let mut v = _mm256_loadu_si256(dst.as_ptr().add(offset).cast());
+            for source in sources {
+                v = _mm256_xor_si256(v, _mm256_loadu_si256(source.as_ptr().add(offset).cast()));
+            }
+            _mm256_storeu_si256(dst.as_mut_ptr().add(offset).cast(), v);
+        }
+    }
+    for i in chunks * 16..dst.len() {
+        for source in sources {
+            dst[i] ^= source[i];
         }
     }
