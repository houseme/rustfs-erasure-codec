 fn compute_formal_derivative16(work: &mut FlatWork16, n: usize, size: usize) {
+    #[cfg(all(feature = "std", target_arch = "x86_64"))]
+    if n <= 32
+        && n.is_power_of_two()
+        && n <= work.lanes()
+        && size <= work.lane(0).len()
+        && size >= 16
+        && std::is_x86_feature_detected!("avx2")
+    {
+        work.with_lane_views(n, size, |lanes| {
+            for dst_idx in 0..n {
+                let (lower, higher) = lanes.split_at_mut(dst_idx + 1);
+                let dst = &mut *lower[dst_idx];
+                let mut sources: SmallVec<[&[u16]; 5]> = SmallVec::new();
+                let mut bit = 1usize;
+                while bit < n {
+                    if dst_idx & bit == 0 {
+                        let source = dst_idx | bit;
+                        sources.push(&*higher[source - dst_idx - 1]);
+                    }
+                    bit <<= 1;
+                }
+                // SAFETY: AVX2 is detected above; the work-buffer views are equal-sized and disjoint.
+                unsafe {
+                    match sources.len() {
+                        0 => (),
+                        1 => slice_xor_u16(dst, sources[0]),
+                        2 => derivative_xor_avx2(dst, [sources[0], sources[1]]),
+                        3 => derivative_xor_avx2(dst, [sources[0], sources[1], sources[2]]),
+                        4 => derivative_xor_avx2(
+                            dst,
+                            [sources[0], sources[1], sources[2], sources[3]],
+                        ),
+                        5 => derivative_xor_avx2(
+                            dst,
+                            [sources[0], sources[1], sources[2], sources[3], sources[4]],
+                        ),
+                        _ => unreachable!(),
+                    }
+                }
+            }
+        });
+        return;
+    }
