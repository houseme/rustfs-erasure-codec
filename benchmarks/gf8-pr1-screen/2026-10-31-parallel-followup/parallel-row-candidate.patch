+#![cfg(all(feature = "std", rse_x86_avx2))]
+use rustfs_erasure_codec::{Field, galois_8};
+use std::cell::Cell;
+thread_local! { static VIEWS: Cell<usize> = const { Cell::new(0) }; }
+struct Counted;
+impl Field for Counted {
+    const ORDER: usize = 256;
+    type Elem = u8;
+    fn add(a: u8, b: u8) -> u8 {
+        galois_8::add(a, b)
+    }
+    fn mul(a: u8, b: u8) -> u8 {
+        galois_8::mul(a, b)
+    }
+    fn div(a: u8, b: u8) -> u8 {
+        galois_8::div(a, b)
+    }
+    fn exp(a: u8, n: usize) -> u8 {
+        galois_8::exp(a, n)
+    }
+    fn zero() -> u8 {
+        0
+    }
+    fn one() -> u8 {
+        1
+    }
+    fn nth_internal(n: usize) -> u8 {
+        n as u8
+    }
+    fn as_gf8_slice(s: &[u8]) -> Option<&[u8]> {
+        VIEWS.with(|n| n.set(n.get() + 1));
+        Some(s)
+    }
+    fn as_gf8_slice_mut(s: &mut [u8]) -> Option<&mut [u8]> {
+        VIEWS.with(|n| n.set(n.get() + 1));
+        Some(s)
+    }
+}
