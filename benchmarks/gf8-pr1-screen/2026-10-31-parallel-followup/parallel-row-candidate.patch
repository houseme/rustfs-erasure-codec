+        let data = [0x53; 64];
+        let inputs = [&data[..]; 4];
+        let mut output = [0xa5; 16];
+        assert_eq!(
+            kernel.execute_chunk(&[1; 3], &inputs, &mut output, 0),
+            Err(Error::InvalidCustomMatrix)
+        );
+        assert_eq!(output, [0xa5; 16]);
+        assert_eq!(
+            kernel.execute_chunk(&[1; 4], &inputs, &mut output, 60),
+            Err(Error::IncorrectShardSize)
+        );
+        assert_eq!(output, [0xa5; 16]);
+        assert_eq!(
+            kernel.execute_chunk(&[1; 4], &inputs, &mut output, usize::MAX),
+            Err(Error::IncorrectShardSize)
