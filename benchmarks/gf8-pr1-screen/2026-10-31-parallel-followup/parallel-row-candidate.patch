+    struct Broken<const MODE: u8>;
+    impl<const MODE: u8> Field for Broken<MODE> {
+        const ORDER: usize = 256;
+        type Elem = u8;
+        fn add(a: u8, b: u8) -> u8 {
+            galois_8::add(a, b)
+        }
+        fn mul(a: u8, b: u8) -> u8 {
+            galois_8::mul(a, b)
+        }
+        fn div(a: u8, b: u8) -> u8 {
+            galois_8::div(a, b)
+        }
+        fn exp(a: u8, n: usize) -> u8 {
+            galois_8::exp(a, n)
+        }
+        fn zero() -> u8 {
+            0
+        }
+        fn one() -> u8 {
+            1
+        }
+        fn nth_internal(n: usize) -> u8 {
+            n as u8
+        }
+        fn as_gf8_slice(s: &[u8]) -> Option<&[u8]> {
+            if MODE == 1 && s.len() == 10 {
+                None
+            } else if MODE == 2 && s.len() > 16 {
+                Some(&s[..s.len() - 1])
+            } else {
+                Some(s)
+            }
+        }
+        fn as_gf8_slice_mut(s: &mut [u8]) -> Option<&mut [u8]> {
+            if MODE == 3 && !s.is_empty() {
+                let len = s.len();
+                Some(&mut s[..len - 1])
+            } else {
+                Some(s)
+            }
+        }
+    }
+    fn check<const MODE: u8>() {
+        let codec = ReedSolomon::<Broken<MODE>>::new(10, 4).unwrap();
+        let len = 1024 * 1024;
+        let inputs: Vec<Vec<u8>> = (0..10)
+            .map(|r| (0..len).map(|i| (r * 31 + i * 17) as u8).collect())
+            .collect();
+        let matrix = codec.encoding_format().matrix();
+        let row = matrix.get_row(10);
+        let rows = [row];
+        let mut outputs = vec![vec![0xa5; len]];
+        assert!(!codec.try_parallel_table_rows(&rows[..], &inputs, &mut outputs, len, 65536, 4));
+        assert!(outputs[0].iter().all(|&v| v == 0xa5));
+        codec.code_some_slices_par_chunked_with_jobs(&rows[..], &inputs, &mut outputs, 65536, 4);
+        let mut expected = vec![0; len];
+        for (index, input) in inputs.iter().enumerate() {
+            if index == 0 {
+                galois_8::Field::mul_slice(row[index], input, &mut expected);
+            } else {
+                galois_8::Field::mul_slice_add(row[index], input, &mut expected);
+            }
+        }
+        assert_eq!(outputs[0], expected);
+    }
