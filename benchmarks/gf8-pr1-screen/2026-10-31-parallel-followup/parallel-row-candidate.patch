+#![cfg(feature = "std")]
+use rustfs_erasure_codec::{CodecOptions, galois_8::ReedSolomon};
+
+#[test]
+fn custom_matrix_recovery_matches_encoded_shards_across_job_budgets() {
+    let original = ReedSolomon::new(10, 4).unwrap();
+    let basis: Vec<Vec<u8>> = (0..10)
+        .map(|row| (0..10).map(|col| u8::from(row == col)).collect())
+        .collect();
+    let mut rows = vec![vec![0; 10]; 4];
+    original.encode_sep(&basis, &mut rows).unwrap();
+    rows.reverse();
+    for jobs in [1, 4] {
+        let codec = ReedSolomon::with_custom_matrix(
+            10,
+            4,
+            &rows,
+            CodecOptions::builder().max_parallel_jobs(jobs).build(),
+        )
+        .unwrap();
+        for len in [1_048_576, 1_048_577] {
+            let mut shards: Vec<Vec<u8>> = (0..14)
+                .map(|row| {
+                    (0..len)
+                        .map(|i| (row * 47 + i * 29 + i / 31) as u8)
+                        .collect()
+                })
+                .collect();
+            codec.encode(&mut shards).unwrap();
+            for missing in [0, 3, 9] {
+                let mut broken: Vec<Option<Vec<u8>>> = shards.iter().cloned().map(Some).collect();
+                broken[missing] = None;
+                codec.reconstruct_data_opt(&mut broken).unwrap();
+                assert_eq!(
+                    broken[missing].as_ref().unwrap(),
+                    &shards[missing],
+                    "jobs={jobs} len={len} missing={missing}"
+                );
+                for (actual, expected) in broken.iter().zip(&shards) {
+                    assert_eq!(actual.as_ref(), Some(expected));
+                }
+            }
+        }
+    }
