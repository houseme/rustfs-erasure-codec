+            .args(["--exact", "one_missing_data_uses_row_only_at_threshold"])
+            .env(CHILD, "1")
+            .env("RSE_BACKEND_OVERRIDE", "rust-avx2")
+            .status()
+            .unwrap();
+        assert!(ok.success());
+        return;
+    }
+    assert_eq!(galois_8::active_backend_id(), galois_8::BackendId::RustAvx2);
+    let codec = rustfs_erasure_codec::ReedSolomon::<Counted>::new(10, 4).unwrap();
+    for (len, active) in [(1_048_575, false), (1_048_576, true), (1_048_577, true)] {
+        let mut shards: Vec<Vec<u8>> = (0..14)
+            .map(|r| (0..len).map(|i| (r * 73 + i * 19 + i / 17) as u8).collect())
+            .collect();
+        galois_8::ReedSolomon::new(10, 4)
+            .unwrap()
+            .encode(&mut shards)
+            .unwrap();
+        let mut broken: Vec<Option<Vec<u8>>> = shards.iter().cloned().map(Some).collect();
+        broken[4] = None;
+        VIEWS.with(|n| n.set(0));
+        codec.reconstruct_data(&mut broken).unwrap();
+        assert_eq!(VIEWS.with(Cell::get) > 0, active, "len={len}");
+        assert_eq!(broken[4].as_ref().unwrap(), &shards[4]);
+    }
+}
