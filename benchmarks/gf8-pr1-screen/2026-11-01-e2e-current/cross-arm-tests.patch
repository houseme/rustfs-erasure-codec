 class GateTests(unittest.TestCase):
+    def test_candidate_a_must_match_both_preflight_levels(self):
+        gate.check_preflight_levels({"case": [100.0, 102.0]}, "case", 104.0)
+        with self.assertRaises(gate.GateError):
+            gate.check_preflight_levels({"case": [100.0, 102.0]}, "case", 106.0)
+        with self.assertRaises(gate.GateError):
+            gate.check_preflight_levels({"case": [100.0, 104.0]}, "case", 98.7)
+
+    def test_cross_arm_failure_stops_before_acknowledging(self):
+        row = fixture()
+        for phase in gate.STAGES:
+            row[phase]["samples_ns"] = [106.0] * 3
+        first = json.dumps(row) + "\n"
+        class Child:
+            stdout = io.StringIO(first + first)
+            stdin = io.StringIO()
+        child = Child()
+        def accept(value, *_):
+            gate.check_preflight_levels({value["case_id"]: [100.0, 101.0]}, value["case_id"], gate.phase_level(value, "A1", "A2"))
+        with self.assertRaises(gate.GateError):
+            gate.process_cases(child, io.StringIO(), baseline=False, resource_invalid=lambda: False, accept=accept)
+        self.assertEqual(child.stdin.getvalue(), "")
+        self.assertEqual(child.stdout.tell(), len(first))
+
+    def test_candidate_rejects_missing_or_invalid_preflight_levels(self):
+        for refs in ({}, {"case": []}, {"case": [100.0]}, {"case": [100.0, float("nan")]}, {"case": [100.0, 0.0]}):
+            with self.subTest(refs=refs):
+                with self.assertRaises(gate.GateError):
+                    gate.check_preflight_levels(refs, "case", 100.0)
+
     def test_stable_baseline_passes(self):
