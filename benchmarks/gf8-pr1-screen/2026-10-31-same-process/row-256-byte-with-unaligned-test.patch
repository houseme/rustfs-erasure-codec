+    #[cfg(all(feature = "std", rse_x86_avx2))]
+    #[test]
+    fn parallel_avx2_chunks_match_scalar_with_unaligned_views_and_tails() {
+        if !std::is_x86_feature_detected!("avx2") {
+            return;
+        }
+        let kernel = SelectedTableRowKernel::from_backend(BackendId::RustAvx2).unwrap();
+        let rows = [
+            [0u8; 10],
+            [1u8; 10],
+            [0, 1, 2, 255, 16, 31, 128, 57, 203, 7],
+        ];
+        for start in [0usize, 17, 31] {
+            for len in [
+                0usize, 1, 31, 32, 33, 127, 128, 129, 255, 256, 257, 511, 512, 513, 1025,
+            ] {
+                let storage: Vec<Vec<u8>> = (0..10)
+                    .map(|row| {
+                        (0..start + len + 7)
+                            .map(|i| (row * 73 + i * 19 + i / 17) as u8)
+                            .collect()
+                    })
+                    .collect();
+                let inputs: Vec<&[u8]> = storage.iter().map(|input| &input[3..]).collect();
+                for row in rows {
+                    let mut output = vec![0xa5; len + 2];
+                    kernel
+                        .execute_chunk(&row, &inputs, &mut output[1..1 + len], start)
+                        .unwrap();
+                    assert_eq!(output[0], 0xa5);
+                    assert_eq!(output[len + 1], 0xa5);
+                    for offset in 0..len {
+                        let expected =
+                            row.iter()
+                                .zip(&inputs)
+                                .fold(0, |sum, (&coefficient, input)| {
+                                    sum ^ crate::galois_8::mul(coefficient, input[start + offset])
+                                });
+                        assert_eq!(
+                            output[1 + offset],
+                            expected,
+                            "start={start} len={len} offset={offset}"
+                        );
+                    }
+                }
+            }
+        }
+    }
