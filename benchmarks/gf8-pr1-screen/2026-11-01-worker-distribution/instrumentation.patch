+// Diagnostic-only: cache-line separated group counts, one array per crate copy.
+#[repr(align(64))]
+struct DiagnosticCount(core::sync::atomic::AtomicU64);
+static DIAGNOSTIC_GROUPS: [DiagnosticCount; 4] = [const {
+    DiagnosticCount(core::sync::atomic::AtomicU64::new(0))
+}; 4];
+pub(crate) fn diagnostic_reset() {
+    for count in &DIAGNOSTIC_GROUPS {
+        count.0.store(0, core::sync::atomic::Ordering::Relaxed);
+    }
+}
+pub(crate) fn diagnostic_counts() -> [u64; 4] {
+    core::array::from_fn(|i| DIAGNOSTIC_GROUPS[i].0.load(core::sync::atomic::Ordering::Relaxed))
+}
+fn diagnostic_group() {
+    let index = rayon::current_thread_index().expect("diagnostic must run in Rayon pool");
+    DIAGNOSTIC_GROUPS[index].0.fetch_add(1, core::sync::atomic::Ordering::Relaxed);
+}
