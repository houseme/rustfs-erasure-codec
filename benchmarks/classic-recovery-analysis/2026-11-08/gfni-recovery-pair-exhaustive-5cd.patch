+    "gfni,avx2",
+    32,
+    _mm256_setzero_si256,
+    _mm256_loadu_si256,
+    _mm256_set1_epi64x,
+    _mm256_gf2p8affine_epi64_epi8,
+    _mm256_xor_si256,
+    _mm256_storeu_si256
+);
+dot_pair_kernel!(
+    dot_pair_avx512,
+    "gfni,avx512f,avx512bw",
+    64,
+    _mm512_setzero_si512,
+    _mm512_loadu_si512,
+    _mm512_set1_epi64,
+    _mm512_gf2p8affine_epi64_epi8,
+    _mm512_xor_si512,
+    _mm512_storeu_si512
+);
+
