+#[cfg(feature = "std")]
+#[test]
+fn paired_recovery_matches_scalar_for_all_coefficient_pairs() {
+    let data: Vec<Vec<u8>> = (0..4)
+        .map(|j| (0..67).map(|i| (j * 67 + i * 31 + 13) as u8).collect())
+        .collect();
+    let inputs: Vec<&[u8]> = data.iter().map(|v| &v[1..66]).collect();
+    let rows0: Vec<Vec<u8>> = (0..=u8::MAX).map(|c| vec![c, 1, 0x9a, 0]).collect();
+    let rows1: Vec<Vec<u8>> = (0..=u8::MAX).map(|c| vec![0, c, 1, 0x9a]).collect();
+    let oracle = |rows: &[Vec<u8>]| -> Vec<Vec<u8>> {
+        rows.iter()
+            .map(|row| {
+                (0..65)
+                    .map(|index| {
+                        row.iter()
+                            .zip(&inputs)
+                            .fold(0, |sum, (&coefficient, input)| {
+                                sum ^ super::super::super::mul(coefficient, input[index])
+                            })
+                    })
+                    .collect()
+            })
+            .collect()
+    };
+    let expected0 = oracle(&rows0);
+    let expected1 = oracle(&rows1);
+    let mut exercised = 0;
+    for (supported, backend) in [
+        (
+            std::is_x86_feature_detected!("gfni") && std::is_x86_feature_detected!("avx2"),
+            BackendId::RustGfniAvx2,
+        ),
+        (
+            std::is_x86_feature_detected!("gfni")
+                && std::is_x86_feature_detected!("avx512f")
+                && std::is_x86_feature_detected!("avx512bw"),
+            BackendId::RustGfniAvx512,
+        ),
+    ] {
+        if !supported {
+            continue;
+        }
+        exercised += 1;
+        let kernel = SelectedRowKernel::from_backend(backend).unwrap();
+        let mut out0 = [0xa5; 67];
+        let mut out1 = [0xa5; 67];
+        for c0 in 0..=u8::MAX {
+            for c1 in 0..=u8::MAX {
+                let rows = [rows0[c0 as usize].as_slice(), rows1[c1 as usize].as_slice()];
+                kernel
+                    .execute_recovery(
+                        &rows,
+                        &inputs,
+                        &mut [&mut out0[1..66], &mut out1[1..66]],
+                        65,
+                        65,
+                    )
+                    .unwrap();
+                assert_eq!(
+                    &out0[1..66],
+                    expected0[c0 as usize],
+                    "{backend:?} c0={c0} c1={c1}"
+                );
+                assert_eq!(
+                    &out1[1..66],
+                    expected1[c1 as usize],
+                    "{backend:?} c0={c0} c1={c1}"
+                );
+                assert_eq!(
+                    (out0[0], out0[66], out1[0], out1[66]),
+                    (0xa5, 0xa5, 0xa5, 0xa5)
+                );
+            }
+        }
+    }
+    eprintln!("GFNI paired coefficient test executed on {exercised} supported backends");
+}
