@@ -263,0 +308,78 @@ macro_rules! dot_kernel {
+macro_rules! dot_pair_kernel {
+    ($name:ident, $features:literal, $width:literal, $zero:ident, $load:ident,
+     $broadcast:ident, $affine:ident, $xor:ident, $store:ident) => {
+        /// # Safety
+        /// The declared ISA is available; both rows match the inputs, input
+        /// ranges cover the output span and the output slices are disjoint.
+        #[target_feature(enable = $features)]
+        unsafe fn $name(
+            row0: &[u8],
+            row1: &[u8],
+            inputs: &[&[u8]],
+            out0: &mut [u8],
+            out1: &mut [u8],
+            start: usize,
+        ) {
+            let done = out0.len() / $width * $width;
+            for offset in (0..done).step_by($width) {
+                let mut a = $zero();
+                let mut b = $zero();
+                for ((&c0, &c1), input) in row0.iter().zip(row1).zip(inputs) {
+                    if c0 == 0 && c1 == 0 {
+                        continue;
+                    }
+                    // SAFETY: caller validated the input range and target ISA.
+                    let x = unsafe { $load(input.as_ptr().add(start + offset).cast()) };
+                    if c0 != 0 {
+                        let y = if c0 == 1 {
+                            x
+                        } else {
+                            $affine::<0>(x, $broadcast(GFNI_MULTIPLY_MATRICES[c0 as usize]))
+                        };
+                        a = $xor(a, y);
+                    }
+                    if c1 != 0 {
+                        let y = if c1 == 1 {
+                            x
+                        } else {
+                            $affine::<0>(x, $broadcast(GFNI_MULTIPLY_MATRICES[c1 as usize]))
+                        };
+                        b = $xor(b, y);
+                    }
+                }
+                // SAFETY: each store is inside its disjoint validated output.
+                unsafe {
+                    $store(out0.as_mut_ptr().add(offset).cast(), a);
+                    $store(out1.as_mut_ptr().add(offset).cast(), b);
+                }
+            }
+            if done < out0.len() {
+                scalar_tail(row0, inputs, &mut out0[done..], start + done);
+                scalar_tail(row1, inputs, &mut out1[done..], start + done);
+            }
+        }
+    };
+}
+dot_pair_kernel!(
