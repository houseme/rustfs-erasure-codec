[package]
name = "rse-native-nostd-cross"
version = "0.0.0"
edition = "2024"
publish = false
[workspace]
[dependencies]
codec_old = { package = "rustfs-erasure-codec", version = "=9.0.0", default-features = false }
codec_new = { package = "rustfs-erasure-codec", path = "CANDIDATE_PATH", default-features = false }
[features]
simd-gfni = ["codec_old/simd-gfni", "codec_new/simd-gfni"]
simd-accel = ["codec_old/simd-accel", "codec_new/simd-accel"]
