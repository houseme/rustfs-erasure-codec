+                let inputs: [&[u8]; 3] = [&a, &b, &c];
+                let row = [coefficient, 1, 0];
+                let mut dst = [0xa5, 0x5a, 0xc3];
+                scalar_tail(&row, &inputs, &mut dst[1..2], 1);
+                assert_eq!(
+                    dst,
+                    [0xa5, crate::galois_8::mul(coefficient, value) ^ b[1], 0xc3]
+                );
