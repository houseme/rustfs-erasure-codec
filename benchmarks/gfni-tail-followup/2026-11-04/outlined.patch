+#[inline(never)]
+fn scalar_tail_one(row: &[u8], inputs: &[&[u8]], start: usize) -> u8 {
+    let mut value = 0;
+    for (&coefficient, input) in row.iter().zip(inputs) {
+        value ^= match coefficient {
+            0 => 0,
+            1 => input[start],
+            _ => super::super::mul(coefficient, input[start]),
+        };
+    }
+    value
+}
