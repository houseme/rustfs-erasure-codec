+#[cfg(test)]
+mod scalar_tail_tests {
+    use super::scalar_tail;
+
+    #[test]
+    fn single_byte_tail_matches_field_sum_and_preserves_guards() {
+        for coefficient in 0u8..=u8::MAX {
+            for value in 0u8..=u8::MAX {
+                let a = [17, value, 29];
+                let b = [13, value.wrapping_mul(37), 19];
+                let c = [31, value ^ 0xa5, 41];
+                let inputs: [&[u8]; 3] = [&a, &b, &c];
+                let row = [coefficient, 1, 0];
+                let mut dst = [0xa5, 0x5a, 0xc3];
+                scalar_tail(&row, &inputs, &mut dst[1..2], 1);
+                assert_eq!(
+                    dst,
+                    [0xa5, crate::galois_8::mul(coefficient, value) ^ b[1], 0xc3]
+                );
+            }
+        }
+    }
