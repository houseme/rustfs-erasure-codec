+    #[cfg(feature = "std")]
+    #[test]
+    fn recovery_crosses_the_gfni_layout_boundary_in_a_final_chunk() {
+        use crate::{CodecFamily, CodecOptions, ShardSlot, galois_8::ReedSolomon};
+        #[cfg(all(rse_x86_gfni, target_arch = "x86_64", target_endian = "little"))]
+        let _ = crate::galois_8::active_backend_id();
+        for jobs in [1, 0] {
+            let codec = ReedSolomon::with_options(
+                10,
+                4,
+                CodecOptions::builder()
+                    .codec_family(CodecFamily::LeopardGF16)
+                    .max_parallel_jobs(jobs)
+                    .build(),
+            )
+            .unwrap();
+            for tail in [1984usize, 2048, 2112] {
+                let size = 65_536 + tail;
+                let mut source: Vec<Vec<u8>> = (0..14)
+                    .map(|i| (0..size).map(|j| (i * 31 + j * 17) as u8).collect())
+                    .collect();
+                codec.encode(&mut source).unwrap();
+                for missing in [[0usize, 10], [1, 2]] {
+                    let mut shards: Vec<_> =
+                        source.iter().cloned().map(ShardSlot::new_present).collect();
+                    for i in missing {
+                        shards[i].mark_missing();
+                    }
+                    codec.reconstruct(&mut shards).unwrap();
+                    assert!(
+                        shards
+                            .iter()
+                            .zip(&source)
+                            .all(|(s, x)| s.is_present() && s.as_inner() == x),
+                        "jobs={jobs} tail={tail} missing={missing:?}"
+                    );
+                }
             }
         }
     }
