+#[cfg(test)]
+mod identity_count_probe {
+    use super::IDENTITY_COUNTS;
+    use crate::{CodecFamily, CodecOptions, galois_8::ReedSolomon};
+    use core::sync::atomic::Ordering;
+
+    #[test]
+    fn report_recovery_butterfly_coefficients() {
+        use crate::ShardSlot;
+        for (data, parity) in [(10,4),(16,8)] {
+            let codec = ReedSolomon::with_options(data, parity, CodecOptions::builder().codec_family(CodecFamily::LeopardGF16).max_parallel_jobs(1).build()).unwrap();
+            let mut shards: Vec<Vec<u8>> = (0..data+parity).map(|i| vec![i as u8;64]).collect();
+            codec.encode(&mut shards).unwrap();
+            for missing in [vec![0], vec![0,1,2,3], vec![0, data]] {
+                let mut slots: Vec<_> = shards.iter().cloned().map(ShardSlot::new_present).collect();
+                for i in &missing { slots[*i].mark_missing(); }
+                for n in &IDENTITY_COUNTS { n.store(0,Ordering::Relaxed); }
+                codec.reconstruct(&mut slots).unwrap();
+                println!("{data}+{parity} missing={missing:?} log0={} sentinel={} other={}",IDENTITY_COUNTS[0].load(Ordering::Relaxed), IDENTITY_COUNTS[1].load(Ordering::Relaxed), IDENTITY_COUNTS[2].load(Ordering::Relaxed));
+            }
+        }
+    }
+
+    #[test]
+    fn report_encode_butterfly_coefficients() {
+        for (data, parity) in [(6,2),(10,4),(16,8),(32,16)] {
+            let codec = ReedSolomon::with_options(data, parity, CodecOptions::builder().codec_family(CodecFamily::LeopardGF16).max_parallel_jobs(1).build()).unwrap();
+            let mut shards: Vec<Vec<u8>> = (0..data+parity).map(|i| vec![i as u8;64]).collect();
+            for n in &IDENTITY_COUNTS { n.store(0,Ordering::Relaxed); }
+            codec.encode(&mut shards).unwrap();
+            println!("{data}+{parity} log0={} sentinel={} other={}",IDENTITY_COUNTS[0].load(Ordering::Relaxed), IDENTITY_COUNTS[1].load(Ordering::Relaxed), IDENTITY_COUNTS[2].load(Ordering::Relaxed));
+        }
+    }
