+use super::{decode::get_pair_mut_flat, ops::slice_xor, work::FlatWork};
+
+/// Compute the formal derivative of the polynomial represented by work slots.
+///
+/// For i in 1..n: XOR work[i..i+width] into work[i-width..i]
+/// where width = ((i ^ (i-1)) + 1) >> 1.
+/// Go: slicesXor(work[i-width:i], work[i:i+width]) → lower ^= higher
+#[cfg_attr(all(feature = "std", target_arch = "x86_64"), inline(never))]
+pub(super) fn compute_formal_derivative(work: &mut FlatWork, n: usize, size: usize) {
+    for i in 1..n {
+        let width = ((i ^ (i - 1)) + 1) >> 1;
+        #[cfg(all(feature = "std", target_arch = "x86_64"))]
+        if width > 1 && size == work.lane_len() && n <= work.lanes() {
+            let count = core::cmp::min(width, n - i);
+            if let Some((dst, src)) = work.lane_groups_mut(i - width, i, count) {
+                slice_xor(src, dst);
+                continue;
+            }
+        }
+        for j in 0..width {
+            let dst_idx = i - width + j;
+            let src_idx = i + j;
+            if src_idx < n
+                && dst_idx < n
+                && let Some((s, d)) = get_pair_mut_flat(work, src_idx, dst_idx, size)
+            {
+                slice_xor(s, d);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod derivative_group_tests {
+    extern crate alloc;
+    use super::{FlatWork, compute_formal_derivative};
+    use alloc::vec::Vec;
+
+    #[test]
+    fn grouped_derivative_matches_ordered_reference_for_full_and_partial_lanes() {
+        for lanes in [1usize, 2, 3, 4, 7, 8, 15, 16, 31, 32, 33, 64, 65] {
+            for extra in [0usize, 7] {
+                for size in [1usize, 31, 32, 63, 64, 65, 256] {
+                    let lane_len = size + extra;
+                    for n in [0usize, lanes / 2, lanes, lanes + 1] {
+                        let mut expected: Vec<Vec<u8>> = (0..lanes)
+                            .map(|r| {
+                                (0..lane_len)
+                                    .map(|i| (r * 73 + i * 29 + i / 3) as u8)
+                                    .collect()
+                            })
+                            .collect();
+                        let mut work = FlatWork::new(lanes, lane_len);
+                        for (i, lane) in expected.iter().enumerate() {
+                            work.lane_mut(i).copy_from_slice(lane);
+                        }
+                        for i in 1..n {
+                            let width = ((i ^ (i - 1)) + 1) >> 1;
+                            for j in 0..width {
+                                let dst = i - width + j;
+                                let src = i + j;
+                                if src < n && dst < n && src < lanes && dst < lanes && src != dst {
+                                    let (left, right) = expected.split_at_mut(src);
+                                    for (out, input) in
+                                        left[dst][..size].iter_mut().zip(&right[0][..size])
+                                    {
+                                        *out ^= *input;
+                                    }
+                                }
+                            }
+                        }
+                        compute_formal_derivative(&mut work, n, size);
+                        for (i, lane) in expected.iter().enumerate() {
+                            assert_eq!(
+                                work.lane(i),
+                                lane,
+                                "lanes={lanes} size={size} extra={extra} n={n} lane={i}"
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
