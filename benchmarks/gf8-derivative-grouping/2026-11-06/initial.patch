+    /// Borrow two ordered, non-overlapping contiguous groups of complete lanes.
+    pub(super) fn lane_groups_mut(
+        &mut self,
+        left: usize,
+        right: usize,
+        count: usize,
+    ) -> Option<(&mut [u8], &mut [u8])> {
+        let left_end = left.checked_add(count)?;
+        let right_end = right.checked_add(count)?;
+        if count == 0 || left_end > right || right_end > self.lanes {
+            return None;
+        }
+        let size = count.checked_mul(self.lane_len)?;
+        let left_offset = left.checked_mul(self.lane_len)?;
+        let right_offset = right.checked_mul(self.lane_len)?;
+        // SAFETY: both complete lane groups lie in this allocation and the
+        // ordered ranges are disjoint. The returned borrows are exclusive.
+        unsafe {
+            Some((
+                core::slice::from_raw_parts_mut(self.ptr.add(left_offset), size),
+                core::slice::from_raw_parts_mut(self.ptr.add(right_offset), size),
+            ))
+        }
+    }
