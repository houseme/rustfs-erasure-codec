+#[cfg(test)]
+mod derivative_group_tests {
+    extern crate alloc;
+    use super::{FlatWork, compute_formal_derivative};
+    use alloc::vec::Vec;
+
+    #[test]
+    fn grouped_derivative_matches_ordered_reference_for_full_and_partial_lanes() {
+        for lanes in [1usize, 2, 3, 4, 7, 8, 15, 16, 31, 32, 33, 64, 65] {
+            for extra in [0usize, 7] {
+                for size in [1usize, 31, 32, 63, 64, 65, 256] {
+                    let lane_len = size + extra;
+                    for n in [0usize, lanes / 2, lanes, lanes + 1] {
+                        let mut expected: Vec<Vec<u8>> = (0..lanes)
+                            .map(|r| {
+                                (0..lane_len)
+                                    .map(|i| (r * 73 + i * 29 + i / 3) as u8)
+                                    .collect()
+                            })
+                            .collect();
+                        let mut work = FlatWork::new(lanes, lane_len);
+                        for (i, lane) in expected.iter().enumerate() {
+                            work.lane_mut(i).copy_from_slice(lane);
+                        }
+                        for i in 1..n {
+                            let width = ((i ^ (i - 1)) + 1) >> 1;
+                            for j in 0..width {
+                                let dst = i - width + j;
+                                let src = i + j;
+                                if src < n && dst < n && src < lanes && dst < lanes && src != dst {
+                                    for k in 0..size {
+                                        expected[dst][k] ^= expected[src][k];
+                                    }
+                                }
+                            }
+                        }
+                        compute_formal_derivative(&mut work, n, size);
+                        for (i, lane) in expected.iter().enumerate() {
+                            assert_eq!(
+                                work.lane(i),
+                                lane,
+                                "lanes={lanes} size={size} extra={extra} n={n} lane={i}"
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
