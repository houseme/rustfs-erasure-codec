+#[cfg(test)]
+mod tests {
+    extern crate alloc;
+    use super::super::{init_leopard_gf16_tables, ops};
+    use super::*;
+    use alloc::vec;
+    use alloc::vec::Vec;
+
+    fn enabled() -> bool {
+        if !std::is_x86_feature_detected!("avx2")
+            || !std::is_x86_feature_detected!("gfni")
+            || !std::is_x86_feature_detected!("avx512f")
+            || !std::is_x86_feature_detected!("avx512bw")
+        {
+            return false;
+        }
+        let backend = crate::galois_8::active_backend_id();
+        std::println!("GFNI512 layout backend={backend:?}");
+        backend == crate::galois_8::BackendId::RustGfniAvx512
+    }
+
+    #[test]
+    fn gfni512_layout_matches_256_for_every_multiplier() {
+        if !enabled() {
+            return;
+        }
+        let tables = init_leopard_gf16_tables();
+        let work: [u16; 64] =
+            core::array::from_fn(|i| (i as u16).wrapping_mul(8123).rotate_left((i % 16) as u32));
+        let mut user = [0u8; 130];
+        ops::work_u16_to_user_bytes(&work, &mut user[1..129]);
+        for log_m in 0..u16::MAX {
+            let matrices = super::super::mul_simd::gfni_layout_matrices(log_m, tables).unwrap();
+            let mut expected = [0u16; 64];
+            let mut actual = [0xaaaau16; 66];
+            let mut expected_user = [0u8; 128];
+            let mut actual_user = [0xaau8; 130];
+            // SAFETY: features were detected; buffers are disjoint whole blocks.
+            unsafe {
+                super::super::avx2::user_to_work_gfni(&user[1..129], &mut expected, matrices);
+                user_to_work(&user[1..129], &mut actual[1..65], matrices);
+                super::super::avx2::work_to_user_gfni(&work, &mut expected_user, matrices);
+                work_to_user(&work, &mut actual_user[1..129], matrices);
+            }
+            assert_eq!(&actual[1..65], &expected, "input log={log_m}");
+            assert_eq!(&actual_user[1..129], &expected_user, "output log={log_m}");
+            assert_eq!(actual[0], 0xaaaa);
+            assert_eq!(actual[65], 0xaaaa);
+            assert_eq!(actual_user[0], 0xaa);
+            assert_eq!(actual_user[129], 0xaa);
+        }
+    }
+
+    #[test]
+    fn gfni512_layout_matches_scalar_for_all_values_and_tails() {
+        if !enabled() {
+            return;
+        }
+        let tables = init_leopard_gf16_tables();
+        let all: Vec<u16> = (0..=u16::MAX).collect();
+        for log_m in [0, 1, 31, 1024, 32768, 65534] {
+            let matrices = super::super::mul_simd::gfni_layout_matrices(log_m, tables).unwrap();
+            for len in [32usize, 64, 96, 2016, 2048, 2080, 32768, 65536] {
+                let work = &all[..len];
+                let mut user = vec![0u8; len * 2 + 1];
+                ops::work_u16_to_user_bytes(work, &mut user[1..]);
+                let expected: Vec<u16> = work
+                    .iter()
+                    .map(|&v| ops::mul_log16(v, log_m, &tables.log_lut, &tables.exp_lut))
+                    .collect();
+                let mut actual = vec![0u16; len];
+                let mut expected_user = vec![0u8; len * 2];
+                let mut actual_user = vec![0u8; len * 2 + 1];
+                ops::work_u16_to_user_bytes(&expected, &mut expected_user);
+                // SAFETY: features were detected; buffers are disjoint whole blocks.
+                unsafe {
+                    user_to_work(&user[1..], &mut actual, matrices);
+                    work_to_user(work, &mut actual_user[1..], matrices);
+                }
+                assert_eq!(actual, expected, "input len={len} log={log_m}");
+                assert_eq!(
+                    &actual_user[1..],
+                    expected_user,
+                    "output len={len} log={log_m}"
+                );
+            }
+        }
+    }
+}
