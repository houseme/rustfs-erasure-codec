+//! AVX-512 GFNI multiplication fused with the GF16 split layout.
+use core::arch::x86_64::*;
+
+#[inline]
+#[target_feature(enable = "gfni,avx512f,avx512bw,avx2")]
+unsafe fn multiply(lo: __m512i, hi: __m512i, m: &[__m512i; 4]) -> (__m512i, __m512i) {
+    let l = _mm512_xor_si512(
+        _mm512_gf2p8affine_epi64_epi8::<0>(lo, m[0]),
+        _mm512_gf2p8affine_epi64_epi8::<0>(hi, m[1]),
+    );
+    let h = _mm512_xor_si512(
+        _mm512_gf2p8affine_epi64_epi8::<0>(lo, m[2]),
+        _mm512_gf2p8affine_epi64_epi8::<0>(hi, m[3]),
+    );
+    (l, h)
+}
+
+#[target_feature(enable = "gfni,avx512f,avx512bw,avx2")]
+pub(super) unsafe fn user_to_work(user: &[u8], out: &mut [u16], matrices: [i64; 4]) {
+    let m = [
+        _mm512_set1_epi64(matrices[0]),
+        _mm512_set1_epi64(matrices[1]),
+        _mm512_set1_epi64(matrices[2]),
+        _mm512_set1_epi64(matrices[3]),
+    ];
+    let low_index = _mm512_set_epi64(11, 10, 9, 8, 3, 2, 1, 0);
+    let high_index = _mm512_set_epi64(15, 14, 13, 12, 7, 6, 5, 4);
+    let first_index = _mm512_set_epi64(11, 10, 3, 2, 9, 8, 1, 0);
+    let second_index = _mm512_set_epi64(15, 14, 7, 6, 13, 12, 5, 4);
+    let full = user.len() / 128 * 128;
+    // SAFETY: caller validates all features, equal disjoint buffers and whole 64-byte blocks.
+    unsafe {
+        let src = user.as_ptr();
+        let dst = out.as_mut_ptr().cast::<u8>();
+        for off in (0..full).step_by(128) {
+            let x = _mm512_loadu_si512(src.add(off).cast());
+            let y = _mm512_loadu_si512(src.add(off + 64).cast());
+            let lo = _mm512_permutex2var_epi64(x, low_index, y);
+            let hi = _mm512_permutex2var_epi64(x, high_index, y);
+            let (lo, hi) = multiply(lo, hi, &m);
+            let a = _mm512_unpacklo_epi8(lo, hi);
+            let b = _mm512_unpackhi_epi8(lo, hi);
+            let first = _mm512_permutex2var_epi64(a, first_index, b);
+            let second = _mm512_permutex2var_epi64(a, second_index, b);
+            _mm512_storeu_si512(dst.add(off).cast(), first);
+            _mm512_storeu_si512(dst.add(off + 64).cast(), second);
+        }
+        if full != user.len() {
+            super::avx2::user_to_work_gfni(&user[full..], &mut out[full / 2..], matrices);
+        }
+    }
+}
+
+#[target_feature(enable = "gfni,avx512f,avx512bw,avx2")]
+pub(super) unsafe fn work_to_user(work: &[u16], user: &mut [u8], matrices: [i64; 4]) {
+    let m = [
+        _mm512_set1_epi64(matrices[0]),
+        _mm512_set1_epi64(matrices[1]),
+        _mm512_set1_epi64(matrices[2]),
+        _mm512_set1_epi64(matrices[3]),
+    ];
+    let plane_index = _mm512_set_epi64(7, 5, 3, 1, 6, 4, 2, 0);
+    let first_index = _mm512_set_epi64(11, 10, 9, 8, 3, 2, 1, 0);
+    let second_index = _mm512_set_epi64(15, 14, 13, 12, 7, 6, 5, 4);
+    let full = user.len() / 128 * 128;
+    // SAFETY: caller validates all features, equal disjoint buffers and whole 64-byte blocks.
+    unsafe {
+        let src = work.as_ptr().cast::<u8>();
+        let dst = user.as_mut_ptr();
+        let mask = _mm512_srli_epi16::<8>(_mm512_set1_epi8(-1));
+        for off in (0..full).step_by(128) {
+            let x = _mm512_loadu_si512(src.add(off).cast());
+            let y = _mm512_loadu_si512(src.add(off + 64).cast());
+            let lo = _mm512_permutexvar_epi64(
+                plane_index,
+                _mm512_packus_epi16(_mm512_and_si512(x, mask), _mm512_and_si512(y, mask)),
+            );
+            let hi = _mm512_permutexvar_epi64(
+                plane_index,
+                _mm512_packus_epi16(_mm512_srli_epi16::<8>(x), _mm512_srli_epi16::<8>(y)),
+            );
+            let (lo, hi) = multiply(lo, hi, &m);
+            let first = _mm512_permutex2var_epi64(lo, first_index, hi);
+            let second = _mm512_permutex2var_epi64(lo, second_index, hi);
+            _mm512_storeu_si512(dst.add(off).cast(), first);
+            _mm512_storeu_si512(dst.add(off + 64).cast(), second);
+        }
+        if full != user.len() {
+            super::avx2::work_to_user_gfni(&work[full / 2..], &mut user[full..], matrices);
+        }
+    }
+}
