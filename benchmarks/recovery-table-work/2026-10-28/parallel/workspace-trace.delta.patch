+#[cfg(feature = "std")]
+#[doc(hidden)]
+pub fn __probe_workspace_reset() {
+    use crate::core::leopard_gf16::decode::{
+        PROBE_WORKSPACE_EMPTY, PROBE_WORKSPACE_INCOMPATIBLE, PROBE_WORKSPACE_NEW,
+        PROBE_WORKSPACE_REUSED,
+    };
+    use ::core::sync::atomic::Ordering;
+    for value in [
+        &PROBE_WORKSPACE_NEW,
+        &PROBE_WORKSPACE_EMPTY,
+        &PROBE_WORKSPACE_INCOMPATIBLE,
+        &PROBE_WORKSPACE_REUSED,
+    ] {
+        value.store(0, Ordering::SeqCst);
+    }
+}
+#[cfg(feature = "std")]
+#[doc(hidden)]
+pub fn __probe_workspace_new() -> usize {
+    crate::core::leopard_gf16::decode::PROBE_WORKSPACE_NEW
+        .load(::core::sync::atomic::Ordering::SeqCst)
 }
