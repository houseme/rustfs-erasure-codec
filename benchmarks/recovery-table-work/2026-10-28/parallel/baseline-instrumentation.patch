+#[cfg(all(
+    test,
+    feature = "std",
+    target_arch = "aarch64",
+    target_endian = "little"
+))]
+mod table_work_probe {
+    use super::{WorkCounts, probe_counts};
+    use crate::{CodecFamily, CodecOptions, galois_8::ReedSolomon};
+    fn observe(len: usize, missing: &[usize], jobs: usize) -> WorkCounts {
+        let codec = ReedSolomon::with_options(
+            10,
+            4,
+            CodecOptions::builder()
+                .codec_family(CodecFamily::LeopardGF16)
+                .max_parallel_jobs(jobs)
+                .build(),
+        )
+        .unwrap();
+        let mut original: Vec<Vec<u8>> = (0..14)
+            .map(|i| (0..len).map(|j| (i * 31 + j * 17 + j / 11) as u8).collect())
+            .collect();
+        codec.encode(&mut original).unwrap();
+        let mut shards: Vec<_> = original.iter().cloned().map(Some).collect();
+        for &i in missing {
+            shards[i] = None;
         }
+        *probe_counts().lock().unwrap() = WorkCounts::default();
+        codec.reconstruct(&mut shards).unwrap();
+        let counts = core::mem::take(&mut *probe_counts().lock().unwrap());
+        assert!(
+            shards
+                .iter()
+                .zip(&original)
+                .all(|(actual, expected)| actual.as_ref() == Some(expected))
+        );
+        counts
     }
+    #[test]
+    fn compare_parallel_table_work() {
+        let pool = rayon::ThreadPoolBuilder::new()
+            .num_threads(4)
+            .start_handler(|_| super::enable_probe_for_this_thread())
+            .build()
+            .unwrap();
+        pool.install(|| {
+            for jobs in [1, 2, 4] {
+                for missing in [&[0, 10][..], &[0, 1, 2, 3][..]] {
+                    let small = observe(65_536, missing, jobs);
+                    let large = observe(1_048_576, missing, jobs);
+                    for (short, long) in [(&small.input, &large.input), (&small.output, &large.output)] {
+                        assert_eq!(short.len(), long.len());
+                        for (log_m, count) in short { assert_eq!(long.get(log_m), Some(&(count * 16))); }
+                    }
+                    let union = small.input.keys().chain(small.output.keys()).copied().collect::<std::collections::BTreeSet<_>>().len();
+                    std::println!("jobs={jobs} missing={missing:?} small_input={} small_output={} large_input={} large_output={} union_unique={union}", small.input.values().sum::<usize>(), small.output.values().sum::<usize>(), large.input.values().sum::<usize>(), large.output.values().sum::<usize>());
+                }
+            }
+        });
+    }
