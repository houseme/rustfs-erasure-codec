+fn record_table_build(is_output: bool, log_m: u16) {
+    if !PROBE_THREAD.with(|enabled| enabled.get()) {
+        return;
+    }
+    let mut counts = probe_counts().lock().unwrap();
+    let side = if is_output {
+        &mut counts.output
+    } else {
+        &mut counts.input
+    };
+    *side.entry(log_m).or_default() += 1;
+}
