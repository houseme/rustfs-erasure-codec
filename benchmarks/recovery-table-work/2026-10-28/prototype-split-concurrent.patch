+#![cfg(feature = "std")]
+use rayon::prelude::*;
+use rustfs_erasure_codec::{CodecFamily, CodecOptions, galois_8::ReedSolomon};
+
+#[test]
+fn concurrent_serial_recovery_keeps_selective_targets_independent() {
+    let pool = rayon::ThreadPoolBuilder::new()
+        .num_threads(4)
+        .build()
+        .unwrap();
+    pool.install(|| {
+        (0..12usize).into_par_iter().for_each(|seed| {
+            let data = 10;
+            let codec = ReedSolomon::with_options(
+                data,
+                4,
+                CodecOptions::builder()
+                    .codec_family(CodecFamily::LeopardGF16)
+                    .max_parallel_jobs(1)
+                    .build(),
+            )
+            .unwrap();
+            let mut original: Vec<Vec<u8>> = (0..14)
+                .map(|shard| {
+                    (0..65_600)
+                        .map(|offset| (seed * 37 + shard * 31 + offset * 17 + offset / 11) as u8)
+                        .collect()
+                })
+                .collect();
+            codec.encode(&mut original).unwrap();
+            for required in [[true, false], [false, true], [true, true], [true, false]] {
+                let mut shards: Vec<_> = original.iter().cloned().map(Some).collect();
+                shards[0] = None;
+                shards[data] = None;
+                let mut mask = vec![false; 14];
+                mask[0] = required[0];
+                mask[data] = required[1];
+                codec.reconstruct_some(&mut shards, &mask).unwrap();
+                for (index, actual) in shards.iter().enumerate() {
+                    let intentionally_missing =
+                        (index == 0 && !required[0]) || (index == data && !required[1]);
+                    let expected = if intentionally_missing {
+                        None
+                    } else {
+                        Some(&original[index])
+                    };
+                    assert_eq!(
+                        actual.as_ref(),
+                        expected,
+                        "seed={seed} required={required:?} index={index}"
+                    );
+                }
+            }
+        });
+    });
+}
+
+#[test]
+fn prepared_shape_boundary_preserves_selected_recovery() {
+    for data in [28, 29] {
+        let codec = ReedSolomon::with_options(
+            data,
+            4,
+            CodecOptions::builder()
+                .codec_family(CodecFamily::LeopardGF16)
+                .max_parallel_jobs(1)
+                .build(),
+        )
+        .unwrap();
+        let mut original: Vec<Vec<u8>> = (0..data + 4)
+            .map(|shard| {
+                (0..65_600)
+                    .map(|offset| (shard * 31 + offset * 17 + offset / 11) as u8)
+                    .collect()
+            })
+            .collect();
+        codec.encode(&mut original).unwrap();
+        for required_index in [0, data] {
+            let mut shards: Vec<_> = original.iter().cloned().map(Some).collect();
+            shards[0] = None;
+            shards[data] = None;
+            let mut mask = vec![false; data + 4];
+            mask[required_index] = true;
+            codec.reconstruct_some(&mut shards, &mask).unwrap();
+            for (index, actual) in shards.iter().enumerate() {
+                let intentionally_missing =
+                    (index == 0 || index == data) && index != required_index;
+                let expected = if intentionally_missing {
+                    None
+                } else {
+                    Some(&original[index])
+                };
+                assert_eq!(
+                    actual.as_ref(),
+                    expected,
+                    "data={data} requested={required_index} index={index}"
+                );
+            }
+        }
+    }
+}
