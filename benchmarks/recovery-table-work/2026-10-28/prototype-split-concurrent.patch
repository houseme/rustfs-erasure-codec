+#[cfg(all(feature = "std", target_arch = "aarch64", target_endian = "little"))]
+#[inline(never)]
+#[allow(clippy::too_many_arguments)]
+fn reconstruct_serial_prepared(
+    driver: &LeopardGf16DecodeDriver,
+    present: &[bool],
+    outputs: &mut [&mut [u8]],
+    input_data: &[Option<&[u8]>],
+    err_locs: &[u16; ORDER16],
+    ifft_plan: &IfftDit16Plan,
+    fft_plan: &FftDit16Plan,
+    tables: &LeopardGf16Tables,
+    missing: &[(usize, usize, u16)],
+    shard_u16_len: usize,
+    chunk_cap: usize,
+) -> Result<(), Error> {
+    let mut prepared = super::fused::PreparedScales::new(present.len());
+    for (index, is_present) in present.iter().copied().enumerate() {
+        if is_present {
+            let work_idx = if index < driver.data_shards {
+                driver.m + index
+            } else {
+                index - driver.data_shards
+            };
+            prepared.add(false, err_locs[work_idx], tables);
+        }
     }
+    for &(_, _, inverse) in missing {
+        prepared.add(true, inverse, tables);
+    }
+    reconstruct_serial_loop(
+        driver,
+        present,
+        outputs,
+        input_data,
+        err_locs,
+        ifft_plan,
+        fft_plan,
+        tables,
+        missing,
+        shard_u16_len,
+        chunk_cap,
+        Some(&prepared),
+    )
+}
 
