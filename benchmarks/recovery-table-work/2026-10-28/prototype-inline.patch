+#[cfg(all(feature = "std", target_arch = "aarch64", target_endian = "little"))]
+pub(super) struct PreparedScales {
+    entries: smallvec::SmallVec<[(u16, super::mul_simd::NibbleTables16); 32]>,
+}
+#[cfg(all(feature = "std", target_arch = "aarch64", target_endian = "little"))]
+impl PreparedScales {
+    pub(super) fn new(capacity: usize) -> Self {
+        Self {
+            entries: smallvec::SmallVec::with_capacity(capacity),
+        }
+    }
+    pub(super) fn add(&mut self, is_output: bool, log_m: u16, tables: &LeopardGf16Tables) {
+        if log_m == MODULUS16 as u16 || self.entries.iter().any(|(value, _)| *value == log_m) {
+            return;
+        }
+        #[cfg(test)]
+        record_table_build(is_output, log_m);
+        #[cfg(not(test))]
+        let _ = is_output;
+        self.entries.push((
+            log_m,
+            super::mul_simd::NibbleTables16::build(log_m, &tables.log_lut, &tables.exp_lut),
+        ));
+    }
+    fn find(&self, log_m: u16) -> Option<&super::mul_simd::NibbleTables16> {
+        self.entries
+            .iter()
+            .find(|(value, _)| *value == log_m)
+            .map(|(_, table)| table)
+    }
+}
+#[cfg(all(feature = "std", target_arch = "aarch64", target_endian = "little"))]
+pub(super) fn user_to_work_mul_prepared(
+    user: &[u8],
+    out: &mut [u16],
+    scratch: &mut [u16],
+    log_m: u16,
+    tables: &LeopardGf16Tables,
+    prepared: Option<&PreparedScales>,
+) {
+    if let Some(table) = prepared.and_then(|p| p.find(log_m)) {
+        assert_eq!(user.len(), out.len() * 2);
+        assert!(user.len().is_multiple_of(64));
+        assert_eq!(scratch.len(), out.len());
+        // SAFETY: AArch64 has NEON, and the caller supplies disjoint complete blocks.
+        unsafe {
+            neon::user_to_work(user, out, table);
+        }
+    } else {
+        user_to_work_mul(user, out, scratch, log_m, tables);
+    }
+}
