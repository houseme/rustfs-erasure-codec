+fn record_table_build(is_output: bool, log_m: u16) {
+    PROBE_TABLE_BUILDS.with(|counts| {
+        let mut counts = counts.borrow_mut();
+        let side = if is_output {
+            &mut counts.output
+        } else {
+            &mut counts.input
+        };
+        *side.entry(log_m).or_default() += 1;
+    });
+}
