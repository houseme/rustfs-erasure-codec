 /// When `log_m == MODULUS16`, Go uses `sliceXor(work[a], work[c])` which modifies
 /// the second argument: `src ^= dst`. The general path gives the same final result
 /// via `dst ^= src*g^m; src ^= dst`, but the modulus shortcut must match exactly.
+#[cfg(all(test, feature = "std"))]
+static PROBE_ZERO: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+#[cfg(all(test, feature = "std"))]
+static PROBE_SENTINEL: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+#[cfg(all(test, feature = "std"))]
+static PROBE_OTHER: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+#[cfg(all(test, feature = "std"))]
+fn probe_coefficient(log_m: u16) {
+    use std::sync::atomic::Ordering;
+    let count = if log_m == 0 {
+        &PROBE_ZERO
+    } else if log_m == MODULUS16 as u16 {
+        &PROBE_SENTINEL
+    } else {
+        &PROBE_OTHER
+    };
+    count.fetch_add(1, Ordering::Relaxed);
+}
