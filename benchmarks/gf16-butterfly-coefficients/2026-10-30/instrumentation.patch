+#[cfg(all(test, feature = "std"))]
+mod coefficient_work_probe {
+    use super::{PROBE_OTHER, PROBE_SENTINEL, PROBE_ZERO};
+    use crate::{CodecFamily, CodecOptions, galois_8::ReedSolomon};
+    use std::sync::atomic::Ordering;
+    #[test]
+    fn observe_butterfly_multiplier_categories() {
+        let tables = super::super::init_leopard_gf16_tables();
+        let zeros: Vec<usize> = tables
+            .fft_skew
+            .iter()
+            .enumerate()
+            .filter_map(|(i, &v)| (v == 0).then_some(i))
+            .collect();
+        println!("SKEW zeros={} first={:?}", zeros.len(), zeros.first());
+        for (data, parity) in [(10, 4), (16, 8)] {
+            for size in [65536, 1048576] {
+                for missing in [1, 4] {
+                    let codec = ReedSolomon::with_options(
+                        data,
+                        parity,
+                        CodecOptions::builder()
+                            .codec_family(CodecFamily::LeopardGF16)
+                            .max_parallel_jobs(4)
+                            .build(),
+                    )
+                    .unwrap();
+                    let mut original: Vec<Vec<u8>> = (0..data + parity)
+                        .map(|i| (0..size).map(|j| (i * 31 + j * 17) as u8).collect())
+                        .collect();
+                    codec.encode(&mut original).unwrap();
+                    let mut shards: Vec<_> = original.iter().cloned().map(Some).collect();
+                    for s in &mut shards[..missing] {
+                        *s = None;
+                    }
+                    for c in [&PROBE_ZERO, &PROBE_SENTINEL, &PROBE_OTHER] {
+                        c.store(0, Ordering::Relaxed);
+                    }
+                    codec.reconstruct_opt(&mut shards).unwrap();
+                    assert!(
+                        shards
+                            .iter()
+                            .zip(&original)
+                            .all(|(x, y)| x.as_ref() == Some(y))
+                    );
+                    println!(
+                        "COEFF data={data} parity={parity} bytes={size} missing={missing} zero={} sentinel={} other={}",
+                        PROBE_ZERO.load(Ordering::Relaxed),
+                        PROBE_SENTINEL.load(Ordering::Relaxed),
+                        PROBE_OTHER.load(Ordering::Relaxed)
+                    );
+                }
+            }
+        }
+    }
+}
