+#[cfg(all(feature = "std", target_arch = "x86_64", target_endian = "little"))]
+fn try_radix4_sentinel<const INVERSE: bool>(
+    a: &mut [u16],
+    b: &mut [u16],
+    c: &mut [u16],
+    d: &mut [u16],
+    log_m23: u16,
+    tables: &LeopardGf16Tables,
+) -> bool {
+    if a.len() != b.len()
+        || a.len() != c.len()
+        || a.len() != d.len()
+        || a.len() < 32
+        || log_m23 == MODULUS16 as u16
+        || !is_x86_feature_detected!("avx2")
+    {
+        return false;
+    }
+    if INVERSE {
+        dit2_step_inv16(c, d, log_m23, tables);
+    }
+    // SAFETY: AVX2 was detected and the four equal-sized mutable lanes are disjoint.
+    unsafe {
+        xor_three_avx2::<INVERSE>(a, b, c, d);
+    }
+    if !INVERSE {
+        dit2_step16(c, d, log_m23, tables);
+    }
+    true
+}
+
+#[cfg(all(feature = "std", target_arch = "x86_64", target_endian = "little"))]
+#[target_feature(enable = "avx2")]
+unsafe fn xor_three_avx2<const INVERSE: bool>(
+    a: &[u16],
+    b: &mut [u16],
+    c: &mut [u16],
+    d: &mut [u16],
+) {
+    use core::arch::x86_64::{_mm256_loadu_si256, _mm256_storeu_si256, _mm256_xor_si256};
+    let chunks = a.len() / 16;
+    // SAFETY: callers supply four equal-sized disjoint lanes; each vector stays in a complete chunk.
+    unsafe {
+        for i in 0..chunks {
+            let off = i * 16;
+            let av = _mm256_loadu_si256(a.as_ptr().add(off).cast());
+            let bv = _mm256_loadu_si256(b.as_ptr().add(off).cast());
+            let cv = _mm256_loadu_si256(c.as_ptr().add(off).cast());
+            let dv = _mm256_loadu_si256(d.as_ptr().add(off).cast());
+            let bn = _mm256_xor_si256(bv, av);
+            let cn = _mm256_xor_si256(cv, av);
+            let dn = _mm256_xor_si256(dv, if INVERSE { bn } else { bv });
+            _mm256_storeu_si256(b.as_mut_ptr().add(off).cast(), bn);
+            _mm256_storeu_si256(c.as_mut_ptr().add(off).cast(), cn);
+            _mm256_storeu_si256(d.as_mut_ptr().add(off).cast(), dn);
+        }
+    }
+    for i in chunks * 16..a.len() {
+        let old_b = b[i];
+        b[i] ^= a[i];
+        c[i] ^= a[i];
+        d[i] ^= if INVERSE { b[i] } else { old_b };
+    }
+}
