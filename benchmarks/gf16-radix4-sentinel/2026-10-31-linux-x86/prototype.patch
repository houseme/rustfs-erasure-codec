+#[cfg(all(
+    test,
+    feature = "std",
+    target_arch = "x86_64",
+    target_endian = "little"
+))]
+mod radix4_sentinel_experiment_tests {
+    use super::*;
+    #[test]
+    fn sentinel_radix4_matches_pairwise_reference() {
+        if !std::is_x86_feature_detected!("avx2") {
+            std::println!("AVX2 unavailable");
+            return;
+        }
+        std::println!("AVX2=true: radix4 sentinel executed");
+        let tables = super::super::init_leopard_gf16_tables();
+        for len in [0, 1, 15, 16, 31, 32, 33, 47, 63, 64, 65, 1024, 32768] {
+            for m in [0, 1, 31, 1024, 32768, 65534, MODULUS16 as u16] {
+                for inverse in [false, true] {
+                    let initial: Vec<Vec<u16>> = (0..4)
+                        .map(|k| {
+                            (0..len + 2)
+                                .map(|i| ((i * 9127 + k * 137) & 65535) as u16)
+                                .collect()
+                        })
+                        .collect();
+                    let mut v = initial.clone();
+                    let mut expected = initial;
+                    let (a, rest) = expected.split_at_mut(1);
+                    let (b, rest) = rest.split_at_mut(1);
+                    let (c, d) = rest.split_at_mut(1);
+                    let (a, b, c, d) = (
+                        &mut a[0][1..len + 1],
+                        &mut b[0][1..len + 1],
+                        &mut c[0][1..len + 1],
+                        &mut d[0][1..len + 1],
+                    );
+                    if inverse {
+                        dit2_step_inv16(a, b, MODULUS16 as u16, tables);
+                        dit2_step_inv16(c, d, m, tables);
+                        dit2_step_inv16(b, d, MODULUS16 as u16, tables);
+                        dit2_step_inv16(a, c, MODULUS16 as u16, tables);
+                    } else {
+                        dit2_step16(a, c, MODULUS16 as u16, tables);
+                        dit2_step16(b, d, MODULUS16 as u16, tables);
+                        dit2_step16(a, b, MODULUS16 as u16, tables);
+                        dit2_step16(c, d, m, tables);
+                    }
+                    let (a, rest) = v.split_at_mut(1);
+                    let (b, rest) = rest.split_at_mut(1);
+                    let (c, d) = rest.split_at_mut(1);
+                    let (a, b, c, d) = (
+                        &mut a[0][1..len + 1],
+                        &mut b[0][1..len + 1],
+                        &mut c[0][1..len + 1],
+                        &mut d[0][1..len + 1],
+                    );
+                    if inverse {
+                        ifft_dit4_16(a, b, c, d, MODULUS16 as u16, m, MODULUS16 as u16, tables);
+                    } else {
+                        fft_dit4_16(a, b, c, d, MODULUS16 as u16, m, MODULUS16 as u16, tables);
+                    }
+                    assert_eq!(v, expected, "len={len} multiplier={m} inverse={inverse}");
+                }
+            }
+        }
+    }
+}
