+#[inline(never)]
+pub(super) fn try_apply<const INVERSE: bool>(
+    dst: &mut [u8],
+    src: &mut [u8],
+    low: &[u8; 16],
+    high: &[u8; 16],
+    lut: &[u8; 256],
+) -> bool {
+    if dst.len() != src.len() || dst.len() < 64 || !is_x86_feature_detected!("avx2") {
+        return false;
+    }
+    // SAFETY: AVX2 is available and the equal-length slices are disjoint.
+    unsafe { apply::<INVERSE>(dst, src, low, high, lut) };
+    true
+}
+
+#[target_feature(enable = "avx2")]
+pub(super) unsafe fn apply<const INVERSE: bool>(
+    dst: &mut [u8],
+    src: &mut [u8],
+    low: &[u8; 16],
+    high: &[u8; 16],
+    lut: &[u8; 256],
+) {
+    use core::arch::x86_64::{
+        _mm_loadu_si128, _mm256_and_si256, _mm256_broadcastsi128_si256, _mm256_loadu_si256,
+        _mm256_set1_epi8, _mm256_shuffle_epi8, _mm256_srli_epi64, _mm256_storeu_si256,
+        _mm256_xor_si256,
+    };
+    // SAFETY: both lookup tables contain sixteen bytes.
+    let low = _mm256_broadcastsi128_si256(unsafe { _mm_loadu_si128(low.as_ptr().cast()) });
+    let high = _mm256_broadcastsi128_si256(unsafe { _mm_loadu_si128(high.as_ptr().cast()) });
+    let mask = _mm256_set1_epi8(0x0f);
+    let (dst32, dst_tail) = dst.as_chunks_mut::<32>();
+    let (src32, src_tail) = src.as_chunks_mut::<32>();
+    for (dst, src) in dst32.iter_mut().zip(src32.iter_mut()) {
+        // SAFETY: both chunks are complete and non-overlapping.
+        let mut x = unsafe { _mm256_loadu_si256(dst.as_ptr().cast()) };
+        let mut y = unsafe { _mm256_loadu_si256(src.as_ptr().cast()) };
+        if INVERSE {
+            y = _mm256_xor_si256(y, x);
+        }
+        let lo = _mm256_and_si256(y, mask);
+        let hi = _mm256_and_si256(_mm256_srli_epi64::<4>(y), mask);
+        let product = _mm256_xor_si256(_mm256_shuffle_epi8(low, lo), _mm256_shuffle_epi8(high, hi));
+        x = _mm256_xor_si256(x, product);
+        if !INVERSE {
+            y = _mm256_xor_si256(y, x);
+        }
+        // SAFETY: each chunk contains 32 writable bytes.
+        unsafe {
+            _mm256_storeu_si256(dst.as_mut_ptr().cast(), x);
+            _mm256_storeu_si256(src.as_mut_ptr().cast(), y);
+        }
+    }
+    for (x, y) in dst_tail.iter_mut().zip(src_tail.iter_mut()) {
+        if INVERSE {
+            *y ^= *x;
+        }
+        *x ^= lut[*y as usize];
+        if !INVERSE {
+            *y ^= *x;
+        }
+    }
+}
