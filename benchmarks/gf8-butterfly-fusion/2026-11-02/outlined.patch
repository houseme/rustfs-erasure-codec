+#[cfg(test)]
+mod butterfly_fusion_tests {
+    extern crate alloc;
+    use super::{dit2_step_inv_prebuilt, dit2_step_prebuilt};
+    use alloc::vec::Vec;
+
+    #[test]
+    fn butterfly_matches_scalar_reference_for_all_coefficients_and_tails() {
+        let tables = super::super::init_leopard_gf8_tables();
+        for log in 0u8..=u8::MAX {
+            let lut = &tables.mul_luts[log as usize];
+            for len in [0usize, 1, 31, 32, 63, 64, 65, 95, 96, 127, 128, 129, 256] {
+                for offset in [0usize, 1, 7, 15] {
+                    let original_x: Vec<u8> =
+                        (0..len + offset + 32).map(|i| (i * 37 + 5) as u8).collect();
+                    let original_y: Vec<u8> = (0..len + offset + 32)
+                        .map(|i| (i * 71 + 17) as u8)
+                        .collect();
+                    for inverse in [false, true] {
+                        let mut x = original_x.clone();
+                        let mut y = original_y.clone();
+                        let mut expected_x = x.clone();
+                        let mut expected_y = y.clone();
+                        for i in offset..offset + len {
+                            if log == u8::MAX {
+                                expected_y[i] ^= expected_x[i];
+                            } else if inverse {
+                                expected_y[i] ^= expected_x[i];
+                                expected_x[i] ^= lut.value[expected_y[i] as usize];
+                            } else {
+                                expected_x[i] ^= lut.value[expected_y[i] as usize];
+                                expected_y[i] ^= expected_x[i];
+                            }
+                        }
+                        let func = if inverse {
+                            dit2_step_inv_prebuilt
+                        } else {
+                            dit2_step_prebuilt
+                        };
+                        func(
+                            &mut x[offset..offset + len],
+                            &mut y[offset..offset + len],
+                            log,
+                            &lut.value,
+                            &lut.low,
+                            &lut.high,
+                        );
+                        assert_eq!(
+                            x, expected_x,
+                            "dst log={log} len={len} offset={offset} inverse={inverse}"
+                        );
+                        assert_eq!(
+                            y, expected_y,
+                            "src log={log} len={len} offset={offset} inverse={inverse}"
+                        );
+                    }
+                }
+            }
+        }
+    }
+}
