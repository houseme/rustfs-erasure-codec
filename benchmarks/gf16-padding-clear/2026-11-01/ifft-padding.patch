+    fn decode_reinitializes_stale_padding_before_it_is_read() {
+        use super::{Vec, alloc::vec};
+        let tables = super::init_leopard_gf16_tables();
+        for (data, parity) in [(1, 1), (2, 1), (3, 2), (10, 4), (16, 7), (16, 8)] {
+            for shard_size in [64usize, 192, 65536] {
+                let driver =
+                    super::build_leopard_gf16_decode_driver(data, parity, shard_size).unwrap();
+                let source: Vec<Vec<u8>> = (0..data + parity)
+                    .map(|i| (0..shard_size).map(|j| (i * 31 + j * 17) as u8).collect())
+                    .collect();
+                let mut patterns = vec![vec![0], vec![data - 1], vec![data + parity - 1]];
+                if parity >= 2 {
+                    patterns.push(vec![data - 1, data]);
+                }
+                for missing in patterns {
+                    let mut present = vec![true; data + parity];
+                    for &i in &missing {
+                        present[i] = false;
+                    }
+                    let missing_data: Vec<usize> =
+                        missing.iter().copied().filter(|&i| i < data).collect();
+                    let missing_parity: Vec<usize> =
+                        missing.iter().copied().filter(|&i| i >= data).collect();
+                    let inputs: Vec<Option<&[u8]>> = source
+                        .iter()
+                        .enumerate()
+                        .map(|(i, bytes)| present[i].then_some(bytes.as_slice()))
+                        .collect();
+                    let plan = super::build_decode_plan(
+                        &driver,
+                        &present,
+                        &missing_parity,
+                        &missing_data,
+                        tables,
+                    );
+                    let size = shard_size / 2;
+                    let mut clean = super::FlatWork16::new(driver.n, size);
+                    let mut stale = super::FlatWork16::new(driver.n, size);
+                    for i in 0..driver.n {
+                        stale.lane_mut(i).fill(0xa5a5);
+                    }
+                    let mut clean_scratch = Vec::new();
+                    let mut stale_scratch = Vec::new();
+                    super::compute_reconstruct_chunk(
+                        &mut clean,
+                        &mut clean_scratch,
+                        0,
+                        size,
+                        size,
+                        &present,
+                        &inputs,
+                        &plan.err_locs,
+                        &plan.ifft_plan,
+                        &plan.fft_plan,
+                        tables,
+                        &driver,
+                    )
+                    .unwrap();
+                    super::compute_reconstruct_chunk(
+                        &mut stale,
+                        &mut stale_scratch,
+                        0,
+                        size,
+                        size,
+                        &present,
+                        &inputs,
+                        &plan.err_locs,
+                        &plan.ifft_plan,
+                        &plan.fft_plan,
+                        tables,
+                        &driver,
+                    )
+                    .unwrap();
+                    for i in 0..driver.n {
+                        assert_eq!(
+                            clean.lane(i),
+                            stale.lane(i),
+                            "data={data}, parity={parity}, shard_size={shard_size}, missing={missing:?}, lane={i}"
+                        );
+                    }
+                }
+            }
+        }
+    }
