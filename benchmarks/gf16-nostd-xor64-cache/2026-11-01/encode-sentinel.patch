+#[cfg(all(test, not(feature = "std"), target_arch = "x86_64", target_feature = "avx2"))]
+mod sentinel64_tests {
+    use super::*;
+    use alloc::vec::Vec;
+    #[test]
+    fn forward_sentinel64_matches_original_for_unaligned_lanes() {
+        let tables = init_leopard_gf16_tables();
+        for offset in 0..16 {
+            for m in [0u16, 1, 12345, 65534, super::super::MODULUS16 as u16] {
+                let initial: Vec<Vec<u16>> = (0..4).map(|k| {
+                    (0..64).map(|i| ((i * 7919 + k * 37) & 65535) as u16).collect()
+                }).collect();
+                let mut actual = initial.clone();
+                let mut expected = initial;
+                {
+                    let (a, rest) = expected.split_at_mut(1);
+                    let (b, rest) = rest.split_at_mut(1);
+                    let (c, d) = rest.split_at_mut(1);
+                    fft_dit4_16(&mut a[0][offset..offset + 32], &mut b[0][offset..offset + 32], &mut c[0][offset..offset + 32], &mut d[0][offset..offset + 32], super::super::MODULUS16 as u16, m, super::super::MODULUS16 as u16, tables);
+                }
+                {
+                    let (a, rest) = actual.split_at_mut(1);
+                    let (b, rest) = rest.split_at_mut(1);
+                    let (c, d) = rest.split_at_mut(1);
+                    let (a,b,c,d)=(&a[0][offset..offset+32],&mut b[0][offset..offset+32],&mut c[0][offset..offset+32],&mut d[0][offset..offset+32]);
+                    // SAFETY: this test executes only with target AVX2 and uses disjoint 32-element lanes.
+                    unsafe { fft_sentinel_xor_64(a,b,c,d) };
+                    fft_dit2_16(c,d,m,tables);
+                }
+                assert_eq!(actual, expected, "offset={offset}, m={m}");
+            }
+        }
+    }
