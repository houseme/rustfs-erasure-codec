+#[cfg(all(not(feature = "std"), target_arch = "x86_64", target_feature = "avx2"))]
+#[inline(never)]
+unsafe fn fft_sentinel_xor_64(a: &[u16], b: &mut [u16], c: &mut [u16], d: &mut [u16]) {
+    use core::arch::x86_64::{_mm256_loadu_si256, _mm256_storeu_si256, _mm256_xor_si256};
+    // SAFETY: the caller guarantees four disjoint, 64-byte lanes and AVX2.
+    unsafe {
+        let a = a.as_ptr().cast::<core::arch::x86_64::__m256i>();
+        let b = b.as_mut_ptr().cast::<core::arch::x86_64::__m256i>();
+        let c = c.as_mut_ptr().cast::<core::arch::x86_64::__m256i>();
+        let d = d.as_mut_ptr().cast::<core::arch::x86_64::__m256i>();
+        for i in 0..2 {
+            let av = _mm256_loadu_si256(a.add(i));
+            let bv = _mm256_loadu_si256(b.add(i));
+            let cv = _mm256_loadu_si256(c.add(i));
+            let dv = _mm256_loadu_si256(d.add(i));
+            _mm256_storeu_si256(b.add(i), _mm256_xor_si256(bv, av));
+            _mm256_storeu_si256(c.add(i), _mm256_xor_si256(cv, av));
+            _mm256_storeu_si256(d.add(i), _mm256_xor_si256(dv, bv));
