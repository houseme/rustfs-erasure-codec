+#[cfg(test)]
+mod xor64_dispatch_tests {
+    use super::*;
+
+    #[test]
+    fn xor_matches_scalar_for_uneven_offsets_and_lengths() {
+        for len in [0usize, 1, 15, 16, 31, 32, 33, 64, 129] {
+            for offset in 0..16 {
+                let other_offset = (offset * 5 + 3) % 16;
+                let src: Vec<u16> = (0..len + 32)
+                    .map(|i| (i as u16).wrapping_mul(1073).wrapping_add(31))
+                    .collect();
+                let mut actual = vec![0xace1u16; len + 32];
+                let mut expected = actual.clone();
+                for (d, s) in expected[offset..offset + len].iter_mut().zip(&src[other_offset..other_offset + len]) {
+                    *d ^= *s;
+                }
+                slice_xor_u16(&mut actual[offset..offset + len], &src[other_offset..other_offset + len]);
+                assert_eq!(actual, expected, "len={len} offset={offset}");
+            }
+        }
+    }
+}
