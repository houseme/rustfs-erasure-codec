+unsafe fn xor_encoding_lane_64(dst: &mut [u16], src: &[u16]) {
+    use core::arch::x86_64::{_mm256_loadu_si256, _mm256_storeu_si256, _mm256_xor_si256};
+    // SAFETY: the caller guarantees two valid nonoverlapping 64-byte lanes.
+    unsafe {
+        let d = dst.as_mut_ptr().cast();
+        let s = src.as_ptr().cast();
+        let a = _mm256_xor_si256(_mm256_loadu_si256(d), _mm256_loadu_si256(s));
+        let b = _mm256_xor_si256(_mm256_loadu_si256(d.add(1)), _mm256_loadu_si256(s.add(1)));
+        _mm256_storeu_si256(d, a);
+        _mm256_storeu_si256(d.add(1), b);
+    }
+}
