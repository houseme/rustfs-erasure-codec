+#[cfg(all(test, not(feature = "std")))]
+mod gf16_instance_plan_cache_tests {
+    extern crate std;
+    use super::*;
+    use alloc::{sync::Arc, vec, vec::Vec};
+    use std::sync::Barrier;
+
+    fn codec(data: usize, parity: usize) -> ReedSolomon<crate::galois_8::Field> {
+        ReedSolomon::with_options(data, parity, CodecOptions::builder().codec_family(CodecFamily::LeopardGF16).max_parallel_jobs(1).build()).unwrap()
+    }
+
+    #[test]
+    fn concurrent_first_use_shares_plan_and_clone_starts_empty() {
+        let codec = Arc::new(codec(10, 4));
+        let mut invalid = vec![vec![0u8; 65]; 14];
+        assert_eq!(codec.encode(&mut invalid), Err(crate::Error::IncorrectShardSize));
+        assert!(codec.gf16_encode_plans.get().is_none());
+        let barrier = Arc::new(Barrier::new(8));
+        std::thread::scope(|scope| {
+            for index in 0..8 {
+                let codec = Arc::clone(&codec);
+                let barrier = Arc::clone(&barrier);
+                scope.spawn(move || {
+                    let size = [64usize, 128, 4096][index % 3];
+                    let mut shards: Vec<Vec<u8>> = (0..14).map(|i| (0..size).map(|j| (i * 31 + j * 17 + j / 11) as u8).collect()).collect();
+                    barrier.wait();
+                    codec.encode(&mut shards).unwrap();
+                    assert!(codec.verify(&shards).unwrap());
+                });
+            }
+        });
+        let first = codec.gf16_encode_plans.get().unwrap() as *const _;
+        let mut shards = vec![vec![17u8; 64]; 14];
+        codec.encode(&mut shards).unwrap();
+        assert_eq!(first, codec.gf16_encode_plans.get().unwrap() as *const _);
+        let cloned = codec.as_ref().clone();
+        assert!(cloned.gf16_encode_plans.get().is_none());
+    }
+
+    #[test]
+    fn first_call_does_not_retain_then_reuses_a_bounded_plan() {
+        let codec = codec(10, 4);
+        let mut shards = vec![vec![17u8; 64]; 14];
+        codec.encode(&mut shards).unwrap();
+        assert!(codec.gf16_encode_plans.get().is_none());
+        codec.encode(&mut shards).unwrap();
+        let first = codec.gf16_encode_plans.get().unwrap() as *const _;
+        codec.encode(&mut shards).unwrap();
+        assert_eq!(first, codec.gf16_encode_plans.get().unwrap() as *const _);
+        assert!(codec.verify(&shards).unwrap());
+    }
+
+    #[test]
+    fn oversized_plan_is_not_retained() {
+        let codec = codec(32768, 1);
+        let mut shards = vec![vec![1u8; 64]; 32769];
+        codec.encode(&mut shards).unwrap();
+        assert!(codec.gf16_encode_plans.get().is_none());
+        assert!(codec.verify(&shards).unwrap());
+        assert!(codec.gf16_encode_plans.get().is_none());
+    }
+}
