[workspace]
[package]
name = "rse-small-update-paired"
version = "0.1.0"
edition = "2024"
[dependencies]
base_codec = { package = "rustfs-erasure-codec", path = "../base", default-features = false, features = ["std", "simd-accel"] }
next_codec = { package = "rustfs-erasure-codec", path = "../same", default-features = false, features = ["std", "simd-accel"] }
rayon = "=1.12.0"
