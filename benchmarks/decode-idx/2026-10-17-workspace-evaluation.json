      "change": "decode_idx invalid_indices capacity: total_shard_count() -> parity_shard_count()",
      "commit_at_measurement": null
    },
    "compiler": "rustc 1.99.1 (stable)",
    "target": "aarch64-apple-darwin",
    "profile": "release",
    "features": [
      "std",
      "simd-accel"
    ],
    "benchmark_metrics": false,
    "host_reservation": "local, unreserved",
    "library_recompiled_for_capacity_candidate": true,
    "library_artifact_selected_explicitly_with_rustc_extern": true,
    "repository_runtime_workspace_added": false
  },
  "method": {
    "prototype": "Temporary owned prepared coefficient rows constructed through one unit-basis decode_idx call; not a delivered library workspace. Source/target masks and EncodingFormat are retained; current inputs and outputs are never retained. Index scratch is reused.",
    "prototype_preparation_included": false,
    "measurement_buffers": "Same preallocated input/output buffers for A and B; destination zeroing is outside each timed ABBA window. No per-iteration cloning/allocation or zeroing by the harness.",
    "timed_iteration": "One complete sequence of all progressive batches; odd iteration count makes repeated XOR accumulation end at the original bytes.",
    "basis": "All data indices except 0 and 2, plus the first two parity indices; exactly k source shards.",
    "target_masks": {
      "data": "indices 0 and 2",
      "parity": "the final two parity indices; for 4+2 these also overlap the expected basis, which is allowed by decode_idx"
    },
    "batch_assignment": "Round-robin source columns across batches; allocation cases intentionally retain duplicate 4+2 four-batch rows from the original campaign.",
    "allocation_metric": "Allocation/reallocation calls and cumulative requested bytes on the measured thread; not peak or retained memory. Existing inverse cache was warmed.",
    "timing_order": [
      "A1_library",
      "B1_temporary_prototype",
      "B2_temporary_prototype",
      "A2_library"
    ],
    "relative_drift_limit": 0.05,
    "acceptance": "Per-row drift counts are diagnostic only. All samples are retained; the entire exploratory timing campaign is rejected when any row fails. This unreserved campaign is not acceptance evidence.",
    "correctness": "Every measured complete recovery compared all requested output bytes with the original codeword.",
    "original_precision": "Times were printed to 0.1 ns per restore; ratios/drifts to four decimal places. Original CSV rows are preserved."
  },
  "limitations": [
    "The single ABBA campaign compares 5647098 against a temporary prototype; it predates the capacity fix. No timing campaign was run for the fixed library.",
    "Prototype preparation and first-object latency were not measured; warm results do not prove lifecycle amortization.",
    "Across disjoint input batches for one complete object, total parity projection remains O(parity_targets * k^2); a reusable plan amortizes it across objects, not automatically within the first object.",
    "The capacity fix already eliminates all observed 32+16 hot allocations; old prototype speedups cannot be claimed as remaining workspace benefits.",
    "The prototype is not a public API, full production implementation, or production caller validation.",
    "This is local unreserved exploration, not rustfs/backlog#2853 isolated-host acceptance or a delivered workspace performance claim."
  ],
